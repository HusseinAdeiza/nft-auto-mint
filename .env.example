# ══════════════════════════════════════════════════════════
#  NFT Auto-Mint Bot — Environment Variables
#  Copy this file to .env and fill in your values.
#  NEVER commit your real .env file to GitHub.
# ══════════════════════════════════════════════════════════

# ── REQUIRED ──────────────────────────────────────────────
# Your main wallet private key
PRIVATE_KEY=your_wallet_private_key_here

# ── MULTI-WALLET (optional, up to 5 wallets) ──────────────
# All wallets fire simultaneously at mint time
PRIVATE_KEY_2=second_wallet_private_key
PRIVATE_KEY_3=third_wallet_private_key
PRIVATE_KEY_4=fourth_wallet_private_key
PRIVATE_KEY_5=fifth_wallet_private_key

# ── RPC ENDPOINTS ─────────────────────────────────────────
# Get free RPC from Alchemy (alchemy.com) or Infura (infura.io)
RPC_URL=https://mainnet.infura.io/v3/YOUR_PROJECT_ID
RPC_URL_BASE=https://mainnet.base.org
RPC_URL_ARBITRUM=https://arb1.arbitrum.io/rpc
RPC_URL_POLYGON=https://polygon-rpc.com
RPC_URL_OPTIMISM=https://mainnet.optimism.io
RPC_URL_AVALANCHE=https://api.avax.network/ext/bc/C/rpc
RPC_URL_ROBINHOOD=https://rpc.mainnet.chain.robinhood.com

# ── API KEYS ──────────────────────────────────────────────
# Get free Etherscan API key at etherscan.io/apis
# Same key works for Ethereum, Arbitrum, Base, Polygon etc.
ETHERSCAN_API_KEY=your_etherscan_api_key
ARBISCAN_API_KEY=your_etherscan_api_key
BASESCAN_API_KEY=your_etherscan_api_key
POLYGONSCAN_API_KEY=your_etherscan_api_key

# Get free OpenSea API key at docs.opensea.io/reference/api-overview
OPENSEA_API_KEY=your_opensea_api_key

# ── MINT TIME ─────────────────────────────────────────────
# Set mint time in UTC format — leave blank for auto-detection
# Convert: 4PM GMT+1 = 2026-06-01T15:00:00Z
#          5PM GMT+1 = 2026-06-01T16:00:00Z
#          6PM GMT+1 = 2026-06-01T17:00:00Z
#          7PM GMT+1 = 2026-06-01T18:00:00Z
MINT_START_TIME=

# ── COMPETITIVE SETTINGS ──────────────────────────────────
# How many NFTs to mint per wallet per transaction
MINT_AMOUNT=1

# ETH cost per mint — set 0.0 for free mints
MINT_VALUE_ETH=0.0

# Max gas price ceiling in Gwei
# Bot pays current gas x 3 for priority
# Set high so bot never gets blocked during gas spikes
# Robinhood Chain: 500 is more than enough (~$0.01-0.50 per tx)
# Ethereum mainnet: 200 is safe (~$2-20 per tx)
MAX_GAS_GWEI=500

# How long to wait between retries in milliseconds
# 1000 = 1 second (more aggressive)
# 2000 = 2 seconds (recommended)
RETRY_DELAY=2000

# How often to check eligibility in milliseconds
CHECK_INTERVAL=2000

# Max number of retry attempts before giving up
MAX_RETRIES=30

# Stop bot after first successful mint (true/false)
MINT_ONCE=true

# Minimum wallet balance required to attempt mint
# Bot skips wallet if balance is below this
MIN_BALANCE_ETH=0.00001

# ══════════════════════════════════════════════════════════
#  HOW TO USE — QUICK REFERENCE
# ══════════════════════════════════════════════════════════
#
#  SIMPLE (auto-detects everything):
#  node index.js https://opensea.io/collection/SLUG/overview
#
#  WITH MANUAL TIME:
#  MINT_START_TIME=2026-06-01T17:00:00Z node index.js https://opensea.io/collection/SLUG/overview
#
#  PAID MINT:
#  MINT_VALUE_ETH=0.001 MINT_AMOUNT=2 node index.js https://opensea.io/collection/SLUG/overview
#
#  BYPASS OPENSEA API (when network issues):
#  node -e "
#  require('dotenv').config();
#  const { startMintBot } = require('./src/minter');
#  startMintBot({
#    name: 'Collection Name',
#    contractAddress: '0xYOUR_CONTRACT',
#    chain: 'ethereum',          // ethereum, base, arbitrum, polygon, robinhood
#    rpcUrl: process.env.RPC_URL,
#    openseaUrl: 'https://opensea.io/collection/SLUG',
#    mintStartTime: '2026-06-01T17:00:00Z',
#    mintStage: 'Public',
#    scheduleSource: 'manual'
#  });
#  "
#
#  CHAIN RPC REFERENCE:
#  Robinhood : https://rpc.mainnet.chain.robinhood.com
#  Ethereum  : process.env.RPC_URL
#  Base      : https://mainnet.base.org
#  Arbitrum  : https://arb1.arbitrum.io/rpc
#  Polygon   : https://polygon-rpc.com
#
#  TIME CONVERTER (GMT+1 to UTC):
#  3:00 PM GMT+1 = T14:00:00Z
#  4:00 PM GMT+1 = T15:00:00Z
#  5:00 PM GMT+1 = T16:00:00Z
#  6:00 PM GMT+1 = T17:00:00Z
#  7:00 PM GMT+1 = T18:00:00Z
#  8:00 PM GMT+1 = T19:00:00Z
#
#  PRO TIPS:
#  - Top up ALL wallets before mint time
#  - Run on VPS + laptop simultaneously
#  - Use screen/nohup on VPS to prevent disconnection
#  - Free mints still need gas ETH on the correct chain
#  - Check wallet eligibility on OpenSea before running
# ══════════════════════════════════════════════════════════
